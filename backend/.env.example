# ===== Backend — variáveis de ambiente =====
# Copie para .env e preencha. NUNCA commite o .env real.

# --- Servidor ---
NODE_ENV=development
PORT=3001
# URL do frontend autorizada no CORS (além das já embutidas)
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Service key: SOMENTE no backend. Nunca exponha no frontend.
SUPABASE_SERVICE_KEY=<service-role-key>

# --- E-mail (fase 1 do roadmap) ---
# Sem EMAIL_ENABLED=true (ou sem credenciais), o envio de e-mail é no-op.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Jobs agendados (fase 1 do roadmap) ---
# Ligar em EXATAMENTE UMA instância do backend (lembretes 09:00,
# encerramentos automáticos 00:10, fuso America/Sao_Paulo).
ENABLE_JOBS=false

# --- Observabilidade (Sprint 4) ---
# Sem SENTRY_DSN, o Sentry fica desligado (no-op). Defina para ativar.
SENTRY_DSN=
# Opcional: identifica a versão nos eventos do Sentry (ex.: git sha)
SENTRY_RELEASE=
# Nível de log do Pino: trace|debug|info|warn|error|fatal (default: info em prod, debug em dev)
LOG_LEVEL=
