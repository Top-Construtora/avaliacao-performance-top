# ===== Backend — variáveis de ambiente =====
# Copie para .env e preencha. NUNCA commite o .env real.

# --- Servidor ---
NODE_ENV=development
PORT=3001
# URL do frontend autorizada no CORS (além das já embutidas)
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Service key: SOMENTE no backend. Nunca exponha no frontend.
SUPABASE_SERVICE_KEY=<service-role-key>

# --- E-mail (fase 1 do roadmap) ---
# Sem EMAIL_ENABLED=true (ou sem provedor), o envio de e-mail é no-op.
EMAIL_ENABLED=false

# Provedor preferido: API HTTP da Brevo (porta 443). Use isto quando a
# hospedagem bloquear as portas de SMTP — caso do Render, que descarta
# tráfego de saída em 25/465/587 e faz a conexão ficar pendurada.
# Provedor de envio: edge | brevo | smtp (vazio = escolha automática).
#
# `edge` chama a Edge Function `send-email` na Supabase, que abre o SMTP do
# Gmail de dentro da infraestrutura deles — o Render bloqueia as portas de SMTP,
# por isso o backend não consegue enviar direto. É a opção recomendada em
# produção: remetente é o e-mail corporativo, sem depender de terceiro.
# Requer os secrets GMAIL_EMAIL e GMAIL_APP_PASSWORD no projeto Supabase e
# `supabase functions deploy send-email`.
EMAIL_PROVIDER=

# Alternativa via API HTTP da Brevo. Funciona, mas o remetente sai por um
# subdomínio compartilhado (*.brevosend.com) e a conta exige IP autorizado.
BREVO_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Jobs agendados (fase 1 do roadmap) ---
# Ligar em EXATAMENTE UMA instância do backend (lembretes 09:00,
# encerramentos automáticos 00:10, fuso America/Sao_Paulo).
ENABLE_JOBS=false

# --- Observabilidade (Sprint 4) ---
# Sem SENTRY_DSN, o Sentry fica desligado (no-op). Defina para ativar.
SENTRY_DSN=
# Opcional: identifica a versão nos eventos do Sentry (ex.: git sha)
SENTRY_RELEASE=
# Nível de log do Pino: trace|debug|info|warn|error|fatal (default: info em prod, debug em dev)
LOG_LEVEL=
